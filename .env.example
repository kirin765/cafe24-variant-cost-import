# Cafe24 앱 인증정보 (Cafe24 개발자센터 > 앱 > 인증정보)
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
# state 서명용 비밀키. 비우면 CLIENT_SECRET을 사용한다.
CAFE24_STATE_SECRET=
# OAuth를 시작할 때 mall_id 파라미터를 생략하면 사용할 기본 쇼핑몰 ID
CAFE24_MALL_ID=
# Redirect URI. 비우면 요청 origin 기준 /api/cafe24/oauth/callback을 사용한다.
# Cafe24는 https만 허용하므로 배포 도메인을 지정한다.
CAFE24_REDIRECT_URI=https://cafe24-variant-cost-import.vercel.app/api/cafe24/oauth/callback

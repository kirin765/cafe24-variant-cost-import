# Cafe24 앱 인증정보 (Cafe24 개발자센터 > 앱 > 인증정보)
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=
# state 서명용 비밀키. 비우면 CLIENT_SECRET을 사용한다.
CAFE24_STATE_SECRET=
# OAuth를 시작할 때 mall_id 파라미터를 생략하면 사용할 기본 쇼핑몰 ID
CAFE24_MALL_ID=
# Redirect URI. 비우면 요청 origin 기준 /api/cafe24/oauth/callback을 사용한다.
# Cafe24는 https만 허용하므로 실제 배포 도메인을 넣는다.
# 로컬 개발에서는 비워 두어야 localhost로 콜백이 돌아온다(로컬 http는 Cafe24가 거부하는 점 참고).
CAFE24_REDIRECT_URI=

# Cafe24 Admin API 버전(X-Cafe24-Api-Version 헤더). 비우면 앱 설정 버전을 따른다.
# 품목 공급가(supply_price)를 받으려면 2026-06-15 이후 버전이 필요하다(예: 2026-09-01).
CAFE24_API_VERSION=
# CSV 미리보기 시 품목 조회를 위해 훑는 상품 수 상한(기본 500). 초과하면 잘림을 표시한다.
IMPORT_MAX_PRODUCTS=
# 실제 공급가 쓰기 활성화. 기본 비활성. 테스트몰에서 한 품목 변경·복원을 수동 검증한 뒤 true로 켠다.
IMPORT_WRITE_ENABLED=
# 실행 1회가 쓰는 최대 시간(ms, 기본 45000). 초과하면 남은 행은 pending으로 두고 다음 실행에서 재개한다.
IMPORT_RUN_BUDGET_MS=
# 실행 리스 시간(ms, 기본 120000). 다른 인스턴스의 중복 실행을 막는다.
IMPORT_RUN_LEASE_MS=

# Neon Postgres (Vercel Neon 통합이 자동 주입). 앱 질의는 pooled, migration은 unpooled를 쓴다.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# 토큰 암호화 키. 32바이트 base64. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
TOKEN_ENCRYPTION_KEY=
